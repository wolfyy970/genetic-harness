# genetic-harness environment template.
# Copy to .env (gitignored) and edit. Loaded automatically by `npm run serve`
# and `npm run run` via Node's --env-file-if-exists flag.

# ── HTTP server ───────────────────────────────────────────────────────────
# Listen port (default 3000). Renamed from PORT for HARNESS_* consistency.
HARNESS_PORT=3000

# Bind host. Default 127.0.0.1 (loopback only). Set to 0.0.0.0 for LAN /
# Tailscale access; the server refuses to start that way without a >=16-char
# HARNESS_TOKEN.
HARNESS_HOST=127.0.0.1

# Bearer token. When set, every /api/* request must include
# `Authorization: Bearer <token>`. The dashboard prompts once and stashes
# in localStorage. Generate with: openssl rand -hex 16
# HARNESS_TOKEN=

# ── Archive layout ────────────────────────────────────────────────────────
# Where leaderboard.json, manifest.json, and replay JSON live. Both the
# server (read) and the orchestrator (write) honor this.
HARNESS_ARCHIVE_DIR=./data/archive

# ── LLM defaults ──────────────────────────────────────────────────────────
# These become the default values of `llmBaseUrl`, `llmModel`, `llmApiKey`
# in HarnessConfig. The dashboard run-control form's per-run JSON still
# wins over these — they only set the floor.
HARNESS_LLM_BASE_URL=http://localhost:8000/v1
HARNESS_LLM_MODEL=Qwen3.6-35B-A3B-8bit
HARNESS_LLM_API_KEY=omlx-local

# Set LLM_MOCK=1 to force mock-LLM mode regardless of llmBaseUrl.
# LLM_MOCK=1
